# ==========================================
# Root .gitignore for LinuxArena Project
# ==========================================

# Environment variables & secrets (CRITICAL)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/
venv/
.venv/
env/
ENV/

# Build & Output directories
dist/
build/
frontend/dist/
*.egg-info/
.next/

# Python Cache & Databases
__pycache__/
*.py[cod]
*$py.class
*.db
*.sqlite
*.sqlite3
app.db
linux_arena.db
linux_arena_dev.db
backend/app.db
backend/linux_arena.db
backend/linux_arena_dev.db

# Logs & Runtime data
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
backend/logs/
backend/uploads/

# IDE & Editor Configs
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
